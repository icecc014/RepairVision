syntax = "v1"

type ScheduleItem {
	WorkerId  int64  `json:"workerId"`
	WorkDate  string `json:"workDate"`
	ShiftType string `json:"shiftType"`
	Note      string `json:"note,optional"`
}

type ScheduleQueryRequest {
	WorkerId  int64  `form:"workerId,optional"`
	StartDate string `form:"startDate,optional"`
	EndDate   string `form:"endDate,optional"`
}

type ScheduleListResponse {
	List []ScheduleItem `json:"list"`
}

type ScheduleSaveRequest {
	Items []ScheduleItem `json:"items"`
}

type ScheduleGenerateRequest {
	WeekStart string `json:"weekStart"`
}
type AdminWorkerBoardItem {
	WorkerId       int64    `json:"workerId"`
	Name           string   `json:"name"`
	Username       string   `json:"username"`
	BuildingNames  []string `json:"buildingNames"`
	MaxConcurrent  int64    `json:"maxConcurrent"`
	TodayShift     string   `json:"todayShift"`
	ActiveOrders   int64    `json:"activeOrders"`
	TodayCompleted int64    `json:"todayCompleted"`
	Available      bool     `json:"available"`
}

type AdminWorkerBoardResponse {
	List []AdminWorkerBoardItem `json:"list"`
}
type SlaOverviewRequest {
    Days int64 `form:"days,optional"`
}

type SlaOverviewResponse {
	PendingTimeoutHours    int64       `json:"pendingTimeoutHours"`
	DispatchedTimeoutHours int64       `json:"dispatchedTimeoutHours"`
	PendingOverdue         int64       `json:"pendingOverdue"`
	DispatchedOverdue      int64       `json:"dispatchedOverdue"`
	AvgDispatchMinutes     float64     `json:"avgDispatchMinutes"`
	AvgRepairMinutes       float64     `json:"avgRepairMinutes"`
	OverdueOrders          []OrderItem `json:"overdueOrders"`
}

type DormFeedbackRequest {
	Id      int64  `path:"id"`
	Rating  int64  `json:"rating"`
	Comment string `json:"comment,optional"`
}

type FeedbackRatingItem {
	Rating int64 `json:"rating"`
	Cnt    int64 `json:"cnt"`
}

type FeedbackRecentItem {
	OrderNo      string `json:"orderNo"`
	BuildingId   int64  `json:"buildingId"`
	BuildingName string `json:"buildingName"`
	Room         string `json:"room"`
	WorkerName   string `json:"workerName,optional"`
	Rating       int64  `json:"rating"`
	Comment      string `json:"comment"`
	CreatedAt    string `json:"createdAt"`
}

type AdminFeedbackStatsResponse {
	Total     int64                `json:"total"`
	AvgRating float64              `json:"avgRating"`
	Ratings   []FeedbackRatingItem `json:"ratings"`
	Recent    []FeedbackRecentItem `json:"recent"`
}
type LeaveItem {
	Id         int64  `json:"id"`
	WorkerId   int64  `json:"workerId"`
	WorkerName string `json:"workerName,optional"`
	StartDate  string `json:"startDate"`
	EndDate    string `json:"endDate"`
	Reason     string `json:"reason"`
	Status     int64  `json:"status"`
	StatusText string `json:"statusText"`
	ReviewNote string `json:"reviewNote,optional"`
	CreatedAt  string `json:"createdAt"`
}

type WorkerLeaveSubmitRequest {
	StartDate string `json:"startDate"`
	EndDate   string `json:"endDate"`
	Reason    string `json:"reason"`
}

type WorkerLeaveListRequest {
	Status int64 `form:"status,optional"`
	Page   int64 `form:"page,optional"`
	Size   int64 `form:"size,optional"`
}

type AdminLeaveListRequest {
	WorkerId int64 `form:"workerId,optional"`
	Status   int64 `form:"status,optional"`
	Page     int64 `form:"page,optional"`
	Size     int64 `form:"size,optional"`
}

type LeaveListResponse {
	Total int64       `json:"total"`
	List  []LeaveItem `json:"list"`
}

type LeaveReviewRequest {
	Id         int64  `path:"id"`
	Status     int64  `json:"status"`
	ReviewNote string `json:"reviewNote,optional"`
}

type LeaveIdRequest {
	Id int64 `path:"id"`
}
type NotificationItem {
	Id        int64  `json:"id"`
	Type      string `json:"type"`
	Title     string `json:"title"`
	Content   string `json:"content"`
	OrderId   int64  `json:"orderId,optional"`
	IsRead    int64  `json:"isRead"`
	CreatedAt string `json:"createdAt"`
}

type NotificationListRequest {
	Page       int64 `form:"page,optional"`
	Size       int64 `form:"size,optional"`
	UnreadOnly int64 `form:"unreadOnly,optional"`
}

type NotificationListResponse {
	Total  int64              `json:"total"`
	Unread int64              `json:"unread"`
	List   []NotificationItem `json:"list"`
}

type NotificationIdRequest {
	Id int64 `path:"id"`
}
type PingRequest {
	Name string `path:"name"`
}

type PingResponse {
	Worker string `json:"worker"`
	Map    string `json:"map"`
}

type LoginRequest {
	Username string `json:"username"`
	Password string `json:"password"`
}

type UserInfo {
	Id         int64  `json:"id"`
	Username   string `json:"username"`
	Name       string `json:"name"`
	Role       int64  `json:"role"`
	BuildingId int64  `json:"buildingId,optional"`
}

type LoginResponse {
	Token string   `json:"token"`
	User  UserInfo `json:"user"`
}

type FaultType {
	Id   int64  `json:"id"`
	Code string `json:"code"`
	Name string `json:"name"`
}

type FaultTypeListResponse {
	List []FaultType `json:"list"`
}

type OrderListRequest {
	Status int64 `form:"status,optional"`
    Days   int64 `form:"days,optional"`
	Page   int64 `form:"page,optional"`
	Size   int64 `form:"size,optional"`
}

type AdminBatchDispatchItem {
	OrderId  int64  `json:"orderId"`
	WorkerId int64  `json:"workerId"`
}

type AdminBatchDispatchRequest {
	OrderIds   []int64 `json:"orderIds,optional"`
	BuildingId int64   `json:"buildingId,optional"`
}

type AdminBatchDispatchResponse {
	Dispatched []AdminBatchDispatchItem `json:"dispatched"`
	Remained   int64                    `json:"remained"`
}
type AdminOrderReassignRequest {
	Id       int64  `path:"id"`
	WorkerId int64  `json:"workerId"`
}
type AdminOrderListRequest {
	Status     int64 `form:"status,optional"`
    Days       int64 `form:"days,optional"`
	BuildingId int64 `form:"buildingId,optional"`
	Page       int64 `form:"page,optional"`
	Size       int64 `form:"size,optional"`
}

type OrderIdRequest {
	Id int64 `path:"id"`
}

type CreateOrderRequest {
	Room        string `json:"room"`
	Floor       int64  `json:"floor,optional"`
	FaultType   string `json:"faultType"`
	Description string `json:"description"`
	BuildingId  int64  `json:"buildingId,optional"`
}

type CreateOrderResponse {
	OrderId int64  `json:"orderId"`
	OrderNo string `json:"orderNo"`
}

type OrderItem {
	Id            int64   `json:"id"`
	OrderNo       string  `json:"orderNo"`
	Title         string  `json:"title"`
	Description   string  `json:"description"`
	BuildingId    int64   `json:"buildingId"`
	BuildingName  string  `json:"buildingName"`
	Room          string  `json:"room"`
	Floor         int64   `json:"floor"`
	FaultType     string  `json:"faultType"`
	FaultTypeName string  `json:"faultTypeName"`
	Status        int64   `json:"status"`
	PendingReason string  `json:"pendingReason,optional"`
	Rated           bool    `json:"rated,optional"`
	Rating          int64   `json:"rating,optional"`
	FeedbackComment string  `json:"feedbackComment,optional"`
	StatusText    string  `json:"statusText"`
	WorkerId      int64   `json:"workerId,optional"`
	WorkerName    string  `json:"workerName,optional"`
	WorkerPhone   string  `json:"workerPhone,optional"`
	DispatchScore float64 `json:"dispatchScore,optional"`
	SkillScore    float64 `json:"skillScore,optional"`
	DistanceScore float64 `json:"distanceScore,optional"`
	LoadScore     float64 `json:"loadScore,optional"`
	ReporterId    int64   `json:"reporterId"`
	ReporterName  string  `json:"reporterName,optional"`
	Source        string  `json:"source"`
	CreatedAt     string  `json:"createdAt"`
	UpdatedAt     string  `json:"updatedAt"`
}

type OrderListResponse {
	Total int64       `json:"total"`
	List  []OrderItem `json:"list"`
}

type OrderDetailResponse {
	Order OrderItem `json:"order"`
}

type EmptyResponse {}

type AdminFaultTypeItem {
	Id     int64  `json:"id"`
	Code   string `json:"code"`
	Name   string `json:"name"`
	Sort   int64  `json:"sort"`
	Status int64  `json:"status"`
}

type AdminFaultTypeListResponse {
	List []AdminFaultTypeItem `json:"list"`
}

type AdminFaultTypeCreateRequest {
	Code string `json:"code"`
	Name string `json:"name"`
	Sort int64  `json:"sort,optional"`
}

type AdminFaultTypeUpdateRequest {
	Id     int64  `path:"id"`
	Name   string `json:"name"`
	Sort   int64  `json:"sort,optional"`
	Status int64  `json:"status,optional"`
}

type AdminFaultTypeIdRequest {
	Id int64 `path:"id"`
}

type DispatchRuleItem {
	Id        int64  `json:"id"`
	RuleKey   string `json:"ruleKey"`
	RuleValue string `json:"ruleValue"`
	Enabled   int64  `json:"enabled"`
	Remark    string `json:"remark"`
	UpdatedAt string `json:"updatedAt"`
}

type DispatchRuleListResponse {
	List []DispatchRuleItem `json:"list"`
}

type DispatchRuleCreateRequest {
	RuleKey   string `json:"ruleKey"`
	RuleValue string `json:"ruleValue"`
	Enabled   int64  `json:"enabled,optional"`
	Remark    string `json:"remark,optional"`
}

type DispatchRuleUpdateRequest {
	Id        int64  `path:"id"`
	RuleValue string `json:"ruleValue"`
	Enabled   int64  `json:"enabled,optional"`
	Remark    string `json:"remark,optional"`
}

type AdminUserItem {
	Id          int64    `json:"id"`
	Username    string   `json:"username"`
	Name        string   `json:"name"`
	Phone       string   `json:"phone"`
	Role        int64    `json:"role"`
	RoleText    string   `json:"roleText"`
	BuildingId  int64    `json:"buildingId,optional"`
	Status      int64    `json:"status"`
	StatusText  string   `json:"statusText"`
	BuildingIds []int64  `json:"buildingIds,optional"`
	MaxConcurrent int64   `json:"maxConcurrent,optional"`
	Buildings   []string `json:"buildings,optional"`
	CreatedAt   string   `json:"createdAt"`
}

type AdminUserListRequest {
	Role    int64  `form:"role,optional"`
	Status  int64  `form:"status,optional"`
	Keyword string `form:"keyword,optional"`
}

type AdminUserListResponse {
	List []AdminUserItem `json:"list"`
}

type AdminUserCreateRequest {
	Username    string  `json:"username"`
	Password    string  `json:"password"`
	Name        string  `json:"name"`
	Phone       string  `json:"phone,optional"`
	Role        int64   `json:"role"`
	BuildingId  int64   `json:"buildingId,optional"`
	BuildingIds []int64 `json:"buildingIds,optional"`
	MaxConcurrent int64 `json:"maxConcurrent,optional"`
}

type AdminUserUpdateRequest {
	Id          int64   `path:"id"`
	Name        string  `json:"name"`
	Phone       string  `json:"phone,optional"`
	Role        int64   `json:"role"`
	Status      int64   `json:"status,optional"`
	BuildingId  int64   `json:"buildingId,optional"`
	BuildingIds []int64 `json:"buildingIds,optional"`
	MaxConcurrent int64 `json:"maxConcurrent,optional"`
}

type AdminUserResetPasswordRequest {
	Id       int64  `path:"id"`
	Password string `json:"password"`
}

type AdminUserIdRequest {
	Id int64 `path:"id"`
}

type AdminBuildingItem {
	Id            int64   `json:"id"`
	Code          string  `json:"code"`
	Name          string  `json:"name"`
	PosX          float64 `json:"posX"`
	PosY          float64 `json:"posY"`
	Width         float64 `json:"width"`
	Height        float64 `json:"height"`
	Floors        int64   `json:"floors"`
	FloorHeight   float64 `json:"floorHeight"`
	RoomsPerFloor int64   `json:"roomsPerFloor"`
}

type AdminBuildingListResponse {
	List []AdminBuildingItem `json:"list"`
}

type AdminBuildingCreateRequest {
	Code          string  `json:"code"`
	Name          string  `json:"name"`
	PosX          float64 `json:"posX"`
	PosY          float64 `json:"posY"`
	Width         float64 `json:"width,optional"`
	Height        float64 `json:"height,optional"`
	Floors        int64   `json:"floors"`
	FloorHeight   float64 `json:"floorHeight,optional"`
	RoomsPerFloor int64   `json:"roomsPerFloor"`
}

type AdminBuildingUpdateRequest {
	Id            int64   `path:"id"`
	Code          string  `json:"code"`
	Name          string  `json:"name"`
	PosX          float64 `json:"posX"`
	PosY          float64 `json:"posY"`
	Width         float64 `json:"width,optional"`
	Height        float64 `json:"height,optional"`
	Floors        int64   `json:"floors"`
	FloorHeight   float64 `json:"floorHeight,optional"`
	RoomsPerFloor int64   `json:"roomsPerFloor"`
}

type AdminBuildingIdRequest {
	Id int64 `path:"id"`
}

type RepairRecordItem {
	Id            int64  `json:"id"`
	OrderNo       string `json:"orderNo"`
	Title         string `json:"title"`
	Description   string `json:"description"`
	BuildingId    int64  `json:"buildingId"`
	BuildingName  string `json:"buildingName"`
	Room          string `json:"room"`
	Floor         int64  `json:"floor"`
	FaultType     string `json:"faultType"`
	FaultTypeName string `json:"faultTypeName"`
	Status        int64  `json:"status"`
	StatusText    string `json:"statusText"`
	ReporterId    int64  `json:"reporterId"`
	ReporterName  string `json:"reporterName,optional"`
	WorkerId      int64  `json:"workerId,optional"`
	WorkerName    string `json:"workerName,optional"`
	WorkerPhone   string `json:"workerPhone,optional"`
	Source        string `json:"source"`
	CreatedAt     string `json:"createdAt"`
	DispatchedAt  string `json:"dispatchedAt,optional"`
	StartedAt     string `json:"startedAt,optional"`
	CompletedAt   string `json:"completedAt,optional"`
}

type RepairRecordSummary {
	Total    int64 `json:"total"`
	Pending  int64 `json:"pending"`
	Working  int64 `json:"working"`
	Done     int64 `json:"done"`
	Canceled int64 `json:"canceled"`
}

type RepairRecordListRequest {
	BuildingId int64  `form:"buildingId,optional"`
	Status     int64  `form:"status,optional"`
	FaultType  string `form:"faultType,optional"`
	Keyword    string `form:"keyword,optional"`
	Days       int64  `form:"days,optional"`
	StartDate  string `form:"startDate,optional"`
	EndDate    string `form:"endDate,optional"`
	Page       int64  `form:"page,optional"`
	Size       int64  `form:"size,optional"`
}

type RepairRecordListResponse {
	Total   int64               `json:"total"`
	Summary RepairRecordSummary `json:"summary"`
	List    []RepairRecordItem  `json:"list"`
}

type OperationLogItem {
	Id           int64  `json:"id"`
	UserId       int64  `json:"userId,optional"`
	Username     string `json:"username,optional"`
	Role         int64  `json:"role,optional"`
	Module       string `json:"module"`
	Action       string `json:"action"`
	Method       string `json:"method"`
	Path         string `json:"path"`
	RequestBody  string `json:"requestBody"`
	ResponseCode int64  `json:"responseCode"`
	Ip           string `json:"ip"`
	CostMs       int64  `json:"costMs"`
	CreatedAt    string `json:"createdAt"`
}

type OperationLogListRequest {
	Page    int64  `form:"page,optional"`
	Size    int64  `form:"size,optional"`
	Module    string `form:"module,optional"`
	Action    string `form:"action,optional"`
	Keyword   string `form:"keyword,optional"`
	StartDate string `form:"startDate,optional"`
	EndDate   string `form:"endDate,optional"`
}

type OperationLogListResponse {
	Total int64              `json:"total"`
	List  []OperationLogItem `json:"list"`
}

type WorkerMapBuilding {
	Id            int64   `json:"id"`
	Code          string  `json:"code"`
	Name          string  `json:"name"`
	PosX          float64 `json:"posX"`
	PosY          float64 `json:"posY"`
	Width         float64 `json:"width"`
	Height        float64 `json:"height"`
	Floors        int64   `json:"floors"`
	FloorHeight   float64 `json:"floorHeight"`
	RoomsPerFloor int64   `json:"roomsPerFloor"`
}

type WorkerMapDataResponse {
	Buildings []WorkerMapBuilding `json:"buildings"`
	Orders    []OrderItem         `json:"orders"`
}

type BatchCompleteRequest {
	BuildingId int64  `json:"buildingId"`
	FaultType  string `json:"faultType"`
}

type BatchCompleteResponse {
	Count int64 `json:"count"`
}

type StatsStatusItem {
	Status     int64  `json:"status"`
	StatusText string `json:"statusText"`
	Count      int64  `json:"count"`
}

type StatsBuildingItem {
	BuildingId   int64  `json:"buildingId"`
	BuildingName string `json:"buildingName"`
	Count        int64  `json:"count"`
}

type StatsFaultItem {
	FaultType     string `json:"faultType"`
	FaultTypeName string `json:"faultTypeName"`
	Count         int64  `json:"count"`
}

type StatsDayItem {
	Date  string `json:"date"`
	Count int64  `json:"count"`
}

type AdminStatsResponse {
	Status    []StatsStatusItem   `json:"status"`
	Buildings []StatsBuildingItem `json:"buildings"`
	Faults    []StatsFaultItem    `json:"faults"`
	Recent    []StatsDayItem      `json:"recent"`
}

service order-api {
	@handler PingHandler
	get /ping/:name (PingRequest) returns (PingResponse)

	@handler LoginHandler
	post /api/login (LoginRequest) returns (LoginResponse)

	@handler NotificationListHandler
	get /api/notifications (NotificationListRequest) returns (NotificationListResponse)

	@handler NotificationReadHandler
	post /api/notifications/:id/read (NotificationIdRequest) returns (EmptyResponse)

	@handler NotificationReadAllHandler
	post /api/notifications/read-all returns (EmptyResponse)
	@handler FaultTypesHandler
	get /api/fault-types returns (FaultTypeListResponse)

	@handler DormOrdersHandler
	get /api/dorm/orders (OrderListRequest) returns (OrderListResponse)

	@handler DormOrderDetailHandler
	get /api/dorm/orders/:id (OrderIdRequest) returns (OrderDetailResponse)

	@handler CreateOrderHandler
	post /api/dorm/orders (CreateOrderRequest) returns (CreateOrderResponse)

	@handler DormFeedbackHandler
	post /api/dorm/orders/:id/feedback (DormFeedbackRequest) returns (EmptyResponse)

	@handler CancelOrderHandler
	post /api/dorm/orders/:id/cancel (OrderIdRequest) returns (EmptyResponse)

	@handler WorkerOrdersHandler
	get /api/worker/orders (OrderListRequest) returns (OrderListResponse)

	@handler StartOrderHandler
	post /api/worker/orders/:id/start (OrderIdRequest) returns (EmptyResponse)

	@handler CompleteOrderHandler
	post /api/worker/orders/:id/complete (OrderIdRequest) returns (EmptyResponse)

	@handler AdminOrdersHandler
	get /api/admin/orders (AdminOrderListRequest) returns (OrderListResponse)

	@handler AdminFaultTypesHandler
	get /api/admin/fault-types returns (AdminFaultTypeListResponse)

	@handler AdminFaultTypeCreateHandler
	post /api/admin/fault-types (AdminFaultTypeCreateRequest) returns (EmptyResponse)

	@handler AdminFaultTypeUpdateHandler
	put /api/admin/fault-types/:id (AdminFaultTypeUpdateRequest) returns (EmptyResponse)

	@handler AdminFaultTypeDeleteHandler
	delete /api/admin/fault-types/:id (AdminFaultTypeIdRequest) returns (EmptyResponse)

	@handler AdminDispatchRulesHandler
	get /api/admin/dispatch-rules returns (DispatchRuleListResponse)

	@handler AdminDispatchRuleCreateHandler
	post /api/admin/dispatch-rules (DispatchRuleCreateRequest) returns (EmptyResponse)

	@handler AdminDispatchRuleUpdateHandler
	put /api/admin/dispatch-rules/:id (DispatchRuleUpdateRequest) returns (EmptyResponse)

	@handler AdminUsersHandler
	get /api/admin/users (AdminUserListRequest) returns (AdminUserListResponse)

	@handler AdminUserCreateHandler
	post /api/admin/users (AdminUserCreateRequest) returns (EmptyResponse)

	@handler AdminUserUpdateHandler
	put /api/admin/users/:id (AdminUserUpdateRequest) returns (EmptyResponse)

	@handler AdminUserResetPasswordHandler
	post /api/admin/users/:id/reset-password (AdminUserResetPasswordRequest) returns (EmptyResponse)

	@handler AdminUserDeleteHandler
	delete /api/admin/users/:id (AdminUserIdRequest) returns (EmptyResponse)

	@handler AdminBuildingsHandler
	get /api/admin/buildings returns (AdminBuildingListResponse)

	@handler AdminBuildingCreateHandler
	post /api/admin/buildings (AdminBuildingCreateRequest) returns (EmptyResponse)

	@handler AdminBuildingUpdateHandler
	put /api/admin/buildings/:id (AdminBuildingUpdateRequest) returns (EmptyResponse)

	@handler AdminBuildingDeleteHandler
	delete /api/admin/buildings/:id (AdminBuildingIdRequest) returns (EmptyResponse)

	@handler AdminOperationLogsHandler
	get /api/admin/logs (OperationLogListRequest) returns (OperationLogListResponse)

	@handler AdminRepairRecordsHandler
	get /api/admin/repair-records (RepairRecordListRequest) returns (RepairRecordListResponse)

	@handler WorkerLeaveSubmitHandler
	post /api/worker/leaves (WorkerLeaveSubmitRequest) returns (LeaveItem)

	@handler WorkerLeaveListHandler
	get /api/worker/leaves (WorkerLeaveListRequest) returns (LeaveListResponse)

	@handler WorkerLeaveCancelHandler
	post /api/worker/leaves/:id/cancel (LeaveIdRequest) returns (EmptyResponse)
	@handler WorkerSchedulesHandler
	get /api/worker/schedules (ScheduleQueryRequest) returns (ScheduleListResponse)
	@handler WorkerMapDataHandler
	get /api/worker/map-data returns (WorkerMapDataResponse)

	@handler WorkerBatchCompleteHandler
	post /api/worker/batch-complete (BatchCompleteRequest) returns (BatchCompleteResponse)

	@handler AdminBatchDispatchHandler
	post /api/admin/orders/batch-dispatch (AdminBatchDispatchRequest) returns (AdminBatchDispatchResponse)

	@handler AdminOrderReassignHandler
	post /api/admin/orders/:id/reassign (AdminOrderReassignRequest) returns (EmptyResponse)

	@handler AdminWorkerBoardHandler
	get /api/admin/worker-board returns (AdminWorkerBoardResponse)

	@handler AdminLeaveListHandler
	get /api/admin/leaves (AdminLeaveListRequest) returns (LeaveListResponse)

	@handler AdminLeaveReviewHandler
	post /api/admin/leaves/:id/review (LeaveReviewRequest) returns (EmptyResponse)
	@handler AdminSchedulesHandler
	get /api/admin/schedules (ScheduleQueryRequest) returns (ScheduleListResponse)

	@handler AdminScheduleSaveHandler
	post /api/admin/schedules (ScheduleSaveRequest) returns (ScheduleListResponse)

	@handler AdminScheduleGenerateHandler
	post /api/admin/schedules/generate (ScheduleGenerateRequest) returns (ScheduleListResponse)
	@handler AdminSlaOverviewHandler
	get /api/admin/sla-overview (SlaOverviewRequest) returns (SlaOverviewResponse)

	@handler AdminFeedbackStatsHandler
	get /api/admin/feedback-stats returns (AdminFeedbackStatsResponse)

	@handler AdminStatsHandler
	get /api/admin/stats returns (AdminStatsResponse)
}

