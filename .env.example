# MySQL（单实例承载三个独立库）
MYSQL_ROOT_PASSWORD=change-me-on-first-run

# JWT（长度>=32，P1启用）
JWT_SECRET=please-replace-with-a-random-string-at-least-32-chars

# 服务发现
ETCD_ENDPOINTS=etcd:2379

# 访问端口（web 容器；8080 管理端+移动端，8081 宿管/工人直达入口）
WEB_PORT=8080
PUBLIC_PORT=8081

# 缓存 / 消息队列（P0预留）
REDIS_ADDR=redis:6379
KAFKA_BROKERS=kafka:9092